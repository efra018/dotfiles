[
  {
    "label": "Depurar C",
    "build": {
      "command": "sh",
      "args": [
        "-c",
        "mkdir -p build && gcc -g \"$ZED_FILE\" -o build/programa"
      ],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/programa",
    "request": "launch",
    "adapter": "CodeLLDB",
    "console": "integratedTerminal",
    "stopOnEntry": false
  }
]
